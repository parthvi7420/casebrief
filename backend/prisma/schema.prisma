// CaseBrief Prisma Database Schema
// Digital Fraud Evidence Reconstruction & Incident Reporting Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  DRAFT
  ACTIVE
  REVIEW
  COMPLETED
  ARCHIVED
}

enum FraudType {
  UPI
  PHISHING
  FAKE_JOB
  INVESTMENT
  OTHER
  UNKNOWN
}

enum EvidenceSourceType {
  CHAT
  SCREENSHOT
  IMAGE
  CSV
  PDF
  URL
  TEXT
  BANK_EXPORT
  OTHER
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
}

enum AssertionLevel {
  CONFIRMED
  INFERRED
  ASSUMPTION
  MISSING
}

enum MatchType {
  EXACT
  STRONG
  POSSIBLE
  UNMATCHED
}

enum DuplicateType {
  EXACT_DUPLICATE
  POSSIBLE_DUPLICATE
  CONFLICTING_DUPLICATE
}

model Case {
  id              String         @id @default(uuid())
  caseNumber      String         @unique // e.g. CB-2026-001
  title           String
  description     String?
  status          CaseStatus     @default(DRAFT)
  fraudType       FraudType      @default(PHISHING)
  estimatedLoss   Float          @default(0.0)
  currency        String         @default("INR")
  firstEventAt    DateTime?
  lastEventAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relational links
  evidence             Evidence[]
  extractedEntities    ExtractedEntity[]
  transactions         NormalizedTransaction[]
  matchedPairs         MatchedRecordPair[]
  duplicateFindings    DuplicateFinding[]
  conflicts            Conflict[]
  gaps                 Gap[]
  assertions           ForensicAssertion[]
  timelineEvents       TimelineEvent[]
  moduleHits           ModuleHit[]
  fraudAttempts        FraudAttempt[]
  reportingChecklists  ReportingChecklist[]
  reports              Report[]
  sourceReferences     SourceReference[]

  @@map("cases")
}

model Evidence {
  id               String              @id @default(uuid())
  caseId           String
  filename         String
  originalFilename String?
  mimeType         String              @default("text/plain")
  fileSize         Int                 @default(0)
  sourceType       EvidenceSourceType  @default(TEXT)
  sha256           String              // SHA-256 evidence integrity hash
  extractedText    String?             @db.Text
  redactedPreview  String?             @db.Text
  metadata         Json?
  createdAt        DateTime            @default(now())

  // Relations
  case             Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  transactions     NormalizedTransaction[]
  entities         ExtractedEntity[]
  sourceReferences SourceReference[]

  @@index([caseId])
  @@index([sha256])
  @@map("evidence")
}

model ExtractedEntity {
  id                String       @id @default(uuid())
  caseId            String
  sourceEvidenceId  String?
  category          String       // date, time, amount, url, phone, email, upi, utr, account, keyword
  rawValue          String
  normalizedValue   String?
  contextSnippet    String?
  metadata          Json?
  createdAt         DateTime     @default(now())

  // Relations
  case              Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidence          Evidence?    @relation(fields: [sourceEvidenceId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([category])
  @@map("extracted_entities")
}

model NormalizedTransaction {
  id                   String       @id @default(uuid())
  caseId               String
  sourceEvidenceId     String
  sourceRowIndex       Int?
  date                 String?
  time                 String?
  timestamp            DateTime?
  amount               Float?
  currency             String       @default("INR")
  transactionReference String?      // UTR / Reference ID
  account              String?      // Masked or explicit account
  counterparty         String?      // Payee VPA / Merchant
  description          String?
  status               String?      // SUCCESS, FAILED, PENDING
  rawRecord            Json?
  createdAt            DateTime     @default(now())

  // Relations
  case                 Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidence             Evidence     @relation(fields: [sourceEvidenceId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([transactionReference])
  @@map("normalized_transactions")
}

model MatchedRecordPair {
  id             String     @id @default(uuid())
  caseId         String
  recordAId      String
  recordBId      String
  matchType      MatchType  @default(POSSIBLE)
  confidence     Float      @default(0.0)
  matchedFields  String[]
  reasons        String[]
  createdAt      DateTime   @default(now())

  case           Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("matched_record_pairs")
}

model DuplicateFinding {
  id               String         @id @default(uuid())
  caseId           String
  type             DuplicateType  @default(POSSIBLE_DUPLICATE)
  status           String         @default("DUPLICATE")
  description      String
  recordAId        String
  recordBId        String
  duplicateFields  String[]
  differingFields  String[]
  severity         SeverityLevel  @default(MEDIUM)
  createdAt        DateTime       @default(now())

  case             Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("duplicate_findings")
}

model Conflict {
  id                 String         @id @default(uuid())
  caseId             String
  type               String         // AMOUNT_CONFLICT, TIMESTAMP_CONFLICT, etc.
  field              String?
  description        String
  reason             String?
  status             String         @default("unresolved")
  severity           SeverityLevel  @default(HIGH)

  // Source A
  sourceAEvidenceId  String?
  sourceAValue       String
  sourceALocation    String?

  // Source B
  sourceBEvidenceId  String?
  sourceBValue       String
  sourceBLocation    String?

  createdAt          DateTime       @default(now())

  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("conflicts")
}

model Gap {
  id                 String         @id @default(uuid())
  caseId             String
  field              String         // UTR, Date, Counterparty, etc.
  description        String
  severity           SeverityLevel  @default(MEDIUM)
  sourceEvidenceIds  String[]
  createdAt          DateTime       @default(now())

  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("gaps")
}

model ForensicAssertion {
  id                 String          @id @default(uuid())
  caseId             String
  level              AssertionLevel  @default(CONFIRMED)
  displayBadge       String          // CONFIRMED, INFERRED, INFERRED — UNVERIFIED, MISSING
  claim              String
  rationale          String
  basis              String[]
  sourceEvidenceIds  String[]
  verified           Boolean         @default(false)
  createdAt          DateTime        @default(now())

  case               Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("forensic_assertions")
}

model TimelineEvent {
  id                 String         @id @default(uuid())
  caseId             String
  time               String
  date               String?
  timestamp          DateTime?
  rawTime            String?
  title              String
  description        String
  sourceIds          String[]
  modulesFired       String[]
  confidence         String         @default("CONFIRMED")
  createdAt          DateTime       @default(now())

  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([timestamp])
  @@map("timeline_events")
}

model ModuleHit {
  id                 String         @id @default(uuid())
  caseId             String
  module             String         // Message Analyzer, URL Reputation Check, etc.
  status             String         // hit, idle
  reasons            String[]
  evidenceIds        String[]
  createdAt          DateTime       @default(now())

  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("module_hits")
}

model FraudAttempt {
  id                 String         @id @default(uuid())
  caseId             String
  timestamp          String
  event              String
  reason             String
  modules            String[]
  sourceEvidenceIds  String[]
  createdAt          DateTime       @default(now())

  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("fraud_attempts")
}

model ReportingChecklist {
  id                   String         @id @default(uuid())
  caseId               String
  completionPercentage Float          @default(0.0)
  overallComplete      Boolean        @default(false)
  items                Json           // Array of 12 checklist criteria with status, label, etc.
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  case                 Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("reporting_checklists")
}

model Report {
  id                 String         @id @default(uuid())
  caseId             String
  summary            String?        @db.Text
  isRedacted         Boolean        @default(false)
  reportPayload      Json           // Comprehensive incident report JSON payload
  generatedAt        DateTime       @default(now())

  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("reports")
}

model SourceReference {
  id                 String         @id @default(uuid())
  caseId             String
  evidenceId         String
  filename           String
  location           String?        // Line 18, Row 14, etc.
  extractedValue     String
  entityType         String         // phone, email, amount, url, upi, utr, account, date, other
  contextSnippet     String?
  createdAt          DateTime       @default(now())

  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidence           Evidence       @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([evidenceId])
  @@map("source_references")
}
